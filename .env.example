# =========================================
# Meet Recorder - Environment Variables
# =========================================
# These envs are read inside the RunPod container at runtime.
# Set them on the RunPod endpoint (not in the Docker image).
# =========================================

# ---- Hugging Face (Pyannote 3.1 weights) ----
HF_TOKEN=

# ---- Cloudflare R2 (S3-compatible) ----
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meet-recorder
R2_ENDPOINT_URL=
# Optional:
R2_REGION=auto
R2_AUDIO_PREFIX=audios
R2_TRANSCRIPT_PREFIX=transcripts
R2_PRESIGN_EXPIRY=604800

# ---- Misc ----
SEED_DB_PATH=/app/seed_data.json
SPEECHBRAIN_CACHE=/runpod-volume/speechbrain/spkrec-ecapa-voxceleb
