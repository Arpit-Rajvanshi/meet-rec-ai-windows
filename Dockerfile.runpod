# =============================================
# meet-recorder  —  RunPod-optimised image
#
# Base already contains (DO NOT reinstall):
#   - Python 3.10
#   - torch 2.2.1 + torchaudio 2.2.2 + torchvision
#   - CUDA 12.1.1 + cuDNN 8 (devel headers)
#   - runpod SDK
#   - pip / setuptools / wheel
#
# This layer adds only our app-specific deps:
#   ffmpeg, faster-whisper, pyannote.audio,
#   speechbrain, boto3, and small utilities.
#
# Expected push size: ~200–400 MB (vs ~3.5 GB from scratch)
# =============================================

FROM runpod/pytorch:2.2.1-py3.10-cuda12.1.1-devel-ubuntu22.04

WORKDIR /app

# --- System deps ---
# Only ffmpeg is missing from the base; keep one layer, clean up immediately.
RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        ffmpeg \
        ca-certificates \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# --- Upgrade pip once ---
RUN pip install --no-cache-dir --upgrade pip

# --- Layer A: heavy compiled deps (best cache reuse, changes rarely) ---
# Install pyannote sub-deps explicitly to pin versions and avoid
# pulling heavy optional extras (metrics / database / lightning CLI).
RUN pip install --no-cache-dir \
    "asteroid-filterbanks==0.4.0" \
    "einops>=0.6.0" \
    "pyannote.core==5.0.0" \
    "speechbrain==1.0.2" \
    "faster-whisper==1.2.1"

# --- Layer B: pyannote.audio (pulls pytorch-lightning etc. — unavoidable) ---
RUN pip install --no-cache-dir "pyannote.audio==3.4.0"

# --- Layer C: light runtime deps (changes most often → last for cache) ---
# NOTE: torch, torchaudio, runpod are already in the base — excluded here.
RUN pip install --no-cache-dir \
    "python-dotenv==1.1.1" \
    "soundfile==0.13.1" \
    "boto3==1.34.138" \
    "botocore==1.34.138" \
    "requests==2.32.5" \
    "numpy==1.26.4" \
    "huggingface-hub==0.35.3" \
    "tqdm==4.67.1" \
    "filelock>=3.12.2"

# --- Clean pip cache ---
RUN pip cache purge || true

# --- Application code (invalidates only when source changes) ---
COPY transcription.py        .
COPY diarize.py              .
COPY media_io.py             .
COPY speaker_mapper_voice.py .
COPY transcript_writer.py    .
COPY r2_client.py            .
COPY runpod_handler.py       .
COPY seed_data.json          .

# --- Runtime env ---
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/runpod-volume/huggingface
ENV TORCH_HOME=/runpod-volume/torch
ENV SPEECHBRAIN_CACHE=/runpod-volume/speechbrain/spkrec-ecapa-voxceleb
ENV SEED_DB_PATH=/app/seed_data.json

CMD ["python", "-u", "runpod_handler.py"]
